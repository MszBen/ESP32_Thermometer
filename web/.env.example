# Copy to .env for local testing. On Vercel, set these as environment variables instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never in the browser or the repo). Lets the website save settings and
# send button presses. Supabase dashboard -> Project Settings -> API Keys -> service_role / secret key.
SUPABASE_SERVICE_KEY=your-service-role-key
# Password for the /settings page.
ADMIN_PASSWORD=choose-a-password
